{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://service-catalog.internal/schemas/service-catalog.schema.json",
  "title": "Service Catalog Entry",
  "description": "Identity, ownership, operational, resource, data, and dependency metadata for one service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serviceId",
    "name",
    "team",
    "teamEmail",
    "lifecycle",
    "criticalityTier",
    "repository",
    "dataClassification"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },

    "serviceId":       { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
    "name":            { "type": "string", "minLength": 1 },
    "description":     { "type": "string" },
    "lifecycle":       { "enum": ["experimental", "non-prod", "prod", "sunset"] },
    "criticalityTier": { "enum": [0, 1, 2, 3, "?"] },
    "repository":      { "type": "string", "format": "uri" },
    "runtime":           { "type": "string" },
    "softwareFramework": { "type": "string", "minLength": 1 },

    "team":            { "type": "string", "minLength": 1 },
    "teamEmail":       { "type": "string", "format": "email" },

    "product":         { "type": "string" },
    "valueStream":     { "type": "string" },
    "financeProduct":  { "type": "string" },
    "train":           { "type": "string" },
    "jiraPrefix":      { "type": "string", "minLength": 1 },

    "dataClassification": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] },

    "resources": {
      "type": "array",
      "description": "Provider-managed resources and on-prem equivalents this service provisions or runs on.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "type", "purpose"],
        "properties": {
          "provider":     { "enum": ["aws", "azure", "on-prem"] },
          "type":         { "type": "string", "minLength": 1 },
          "purpose":      { "type": "string", "minLength": 1 },
          "engine":       { "type": "string" },
          "version":      { "type": "string" },
          "instanceType": { "type": "string" },
          "drStrategy": {
            "enum": ["none", "startEmpty", "startRestoreFromBackup", "startWithReplicatedData", "activeActive", "unknown"]
          },
          "primaryInstanceCount": { "type": "integer", "minimum": 0 },
          "minReplicas":    { "type": "integer", "minimum": 0 },
          "maxReplicas":    { "type": "integer", "minimum": 0 },
          "cpuRequest":     { "type": "string" },
          "memoryRequest":  { "type": "string" },
          "cpuLimit":       { "type": "string" },
          "memoryLimit":    { "type": "string" }
        }
      }
    },

    "datastores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "restrictedData", "critical"],
        "properties": {
          "name":           { "type": "string", "minLength": 1 },
          "type":           { "type": "string", "minLength": 1 },
          "restrictedData": { "type": "boolean" },
          "critical":       { "type": "boolean" },
          "retention": {
            "type": "string",
            "description": "ISO 8601 duration. Examples: P7Y, P90D, PT24H, P0D.",
            "pattern": "^P(?=.)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$"
          },
          "engine":     { "type": "string" },
          "version":    { "type": "string" },
          "drStrategy": {
            "enum": ["none", "startEmpty", "startRestoreFromBackup", "startWithReplicatedData", "activeActive", "unknown"]
          }
        }
      }
    },

    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name":        { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },

    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serviceId", "interaction", "critical", "purpose", "external"],
        "properties": {
          "serviceId":   { "type": "string", "minLength": 1 },
          "interaction": { "enum": ["sync-http", "async-http", "async-event", "sftp", "batch", "fdw", "dms", "s3", "infrastructure", "grpc", "soap"] },
          "critical":    { "type": "boolean" },
          "purpose":     { "type": "string", "minLength": 1 },
          "external":    { "type": "boolean" },
          "endpoint":    { "type": "string" },
          "supportsFeatures": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "catalogGroup": { "type": "string" },
    "processingModesSupported": { "type": "array", "items": { "type": "string", "minLength": 1 } },

    "lastUpdatedDate":  { "type": "string", "format": "date" },
    "verifiedBy":       { "type": "string", "minLength": 1 },
    "verificationDate": { "type": "string", "format": "date" },

    "operational": {
      "type": "object",
      "additionalProperties": false,
      "description": "Links to the systems an on-call engineer reaches for during an incident.",
      "properties": {
        "pagerDutyEscalationPolicyLink": { "type": "string", "format": "uri" },
        "runbookUrl":           { "type": "string", "format": "uri" },
        "splunkDashboardURL":   { "type": "string", "format": "uri" },
        "newRelicDashboardURL": { "type": "string", "format": "uri" }
      }
    },

    "drStrategy": {
      "enum": ["none", "activeActive", "activePassiveCold", "activePassiveWarm", "activePassiveHot", "unknown"]
    },

    "excludedDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serviceId", "interaction", "purpose", "external", "exclusionReason"],
        "properties": {
          "serviceId":       { "type": "string", "minLength": 1 },
          "interaction":     { "enum": ["sync-http", "async-http", "async-event", "sftp", "batch", "fdw", "dms", "s3", "infrastructure", "grpc", "soap"] },
          "purpose":         { "type": "string", "minLength": 1 },
          "external":        { "type": "boolean" },
          "endpoint":        { "type": "string" },
          "exclusionReason": { "type": "string", "minLength": 1 }
        }
      }
    },

    "tags": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
