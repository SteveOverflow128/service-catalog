{
  "$schema": "https://service-catalog.internal/schemas/service-catalog.schema.json",

  "serviceId": "task-service",
  "name": "Task Service",
  "description": "Manages tasks, assignments, and due dates for the project-management platform.",
  "lifecycle": "prod",
  "criticalityTier": 1,
  "repository": "https://git.example.com/platform/task-service",
  "provisionerRepoURL": "https://git.example.com/platform/task-service-provisioner",
  "runtime": "java-21",

  "team": "Workflow Team",
  "teamEmail": "workflow-team@example.com",

  "product": "Projects",
  "valueStream": "Collaboration",
  "financeProduct": "Core-Platform",
  "train": "Atlas",
  "jiraPrefix": "TASK",

  "dataClassification": "CONFIDENTIAL",

  "catalogGroup": "Workflow Platform",
  "drStrategy": "activePassiveWarm",

  "lastUpdatedDate": "2026-05-20",
  "verifiedBy": "workflow-team@example.com",
  "verificationDate": "2026-05-20",

  "operational": {
    "pagerDutyEscalationPolicyLink": "https://acme.pagerduty.com/escalation_policies/PWORKFLW",
    "runbookUrl": "https://runbooks.example.com/task-service",
    "splunkDashboardURL": "https://splunk.example.com/app/task-service/overview",
    "newRelicDashboardURL": "https://one.newrelic.com/dashboards/task-service"
  },

  "resources": [
    { "provider": "aws",     "type": "rds",          "purpose": "Primary OLTP store for tasks and assignments", "engine": "postgres", "version": "16.2", "region": "us-east-1", "drStrategy": "startRestoreFromBackup" },
    { "provider": "aws",     "type": "sqs",          "purpose": "Async task-event queue for notifications",      "region": "us-east-1", "drStrategy": "startEmpty" },
    { "provider": "azure",   "type": "blob-storage", "purpose": "Task attachment storage",                       "region": "eastus", "drStrategy": "startWithReplicatedData" },
    { "provider": "on-prem", "type": "vm",           "purpose": "Legacy batch reconciliation worker",            "region": "dc-atlanta", "instanceType": "8c/32g" }
  ],

  "datastores": [
    { "name": "tasks_oltp",       "type": "postgres", "restrictedData": true,  "critical": true,  "retention": "P3Y"  },
    { "name": "task-attachments", "type": "s3",       "restrictedData": true,  "critical": false, "retention": "P1Y" }
  ],

  "features": [
    { "name": "Task Management", "description": "Create, assign, and track tasks with due dates and status transitions" },
    { "name": "Notifications",   "description": "Email and in-app notifications for task assignments and due-date changes" }
  ],

  "dependencies": [
    {
      "serviceId": "auth-service",
      "interaction": "sync-http",
      "critical": true,
      "purpose": "Validate user sessions and resolve permissions",
      "external": false,
      "endpoint": "https://auth-service.internal/v1/verify",
      "supportsFeatures": ["Task Management", "Notifications"]
    },
    {
      "serviceId": "acme-email",
      "interaction": "async-http",
      "critical": false,
      "purpose": "Transactional email delivery for task notifications",
      "external": true,
      "supportsFeatures": ["Notifications"]
    },
    {
      "serviceId": "billing-exports",
      "interaction": "sftp",
      "critical": false,
      "purpose": "Nightly usage export drop for the finance team",
      "external": false
    }
  ],

  "excludedDependencies": [
    {
      "serviceId": "legacy-billing-service",
      "interaction": "sync-http",
      "purpose": "Historical billing data lookup",
      "external": false,
      "endpoint": "https://legacy-billing.internal/v1",
      "exclusionReason": "Decommissioned — data migrated to billing-service as of Q1 2025"
    }
  ],

  "tags": {
    "team": "workflow",
    "iac": "terraform",
    "costCenter": "CC-1001",
    "complianceScope": "SOC2"
  }
}
